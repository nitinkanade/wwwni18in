---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import ContactForm from '../../components/sections/ContactForm.astro';
import MdIcon from '../../components/md3/MdIcon.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const { Content } = await service.render();
---

<BaseLayout 
  title={`${service.data.title} | NI18 Services`}
  description={service.data.description}
>
  <section class="section page-header">
    <div class="container">
      <Breadcrumb items={[
        { name: 'Services', href: '/services' },
        { name: service.data.title }
      ]} />

      <div class="header-content">
        <div class="service-icon">
          <MdIcon name={service.data.icon} size="36px" />
        </div>
        <div>
          <h1 class="display-large">{service.data.title}</h1>
          <p class="body-large sub-desc">{service.data.description}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container detail-grid">
      <div class="prose-content">
        <Content />
      </div>
      <div>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    background-color: var(--md-sys-color-surface-container-low);
  }

  .header-content {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin-top: 1rem;
  }

  .service-icon {
    width: 64px;
    height: 64px;
    border-radius: var(--md-sys-shape-corner-large);
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .detail-grid {
      grid-template-columns: 1fr 420px;
    }
  }
</style>
