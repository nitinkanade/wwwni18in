---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import MdCard from '../components/md3/MdCard.astro';
import MdIcon from '../components/md3/MdIcon.astro';

const industries = [
  { title: 'E-Commerce & Retail', desc: 'Enterprise SFCC B2C cartridges, Page Designer layouts, SCAPI headless storefronts, and conversion optimization.', icon: 'shopping_cart' },
  { title: 'EdTech & Competitive Exams', desc: 'Offline Android apps, formula sheet revision companions, and interactive quiz preparation software.', icon: 'school' },
  { title: 'Digital Tools & Web Utilities', desc: 'High-speed browser utilities operating 100% locally in WebAssembly with zero data transmission.', icon: 'build' },
  { title: 'Consumer Mobile Software', desc: 'Native Kotlin mobile apps built for offline reliability, fast startup times, and smooth 120fps scrolling.', icon: 'smartphone' }
];
---

<BaseLayout 
  title="Industries We Serve | NI18"
  description="NI18 builds specialized software solutions for E-Commerce, EdTech, Mobile Apps, and Privacy-Centric Web Utilities."
>
  <section class="section page-header">
    <div class="container">
      <Breadcrumb items={[{ name: 'Industries' }]} />
      <h1 class="display-large">Industries We Serve</h1>
      <p class="body-large sub-desc">Domain expertise across e-commerce retail, mobile education apps, and browser digital tools.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      {industries.map((ind) => (
        <MdCard variant="outlined" class="ind-card">
          <div class="ind-icon">
            <MdIcon name={ind.icon} size="32px" />
          </div>
          <h3 class="title-large" style="margin-bottom: 0.5rem;">{ind.title}</h3>
          <p class="body-medium">{ind.desc}</p>
        </MdCard>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { background-color: var(--md-sys-color-surface-container-low); }
  .sub-desc { margin-top: 0.75rem; }
  .ind-icon {
    width: 60px;
    height: 60px;
    border-radius: var(--md-sys-shape-corner-large);
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }
</style>
