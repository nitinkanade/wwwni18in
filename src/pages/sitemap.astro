---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { getUrl } from '../utils/navigation';

const apps = await getCollection('apps');
const blogPosts = await getCollection('blog');

const staticPages = [
  { name: 'Home', href: getUrl('/') },
  { name: 'Apps Directory', href: getUrl('/apps') },
  { name: 'Blog Index', href: getUrl('/blog') },
  { name: 'About NI18', href: getUrl('/about') },
  { name: 'Contact Us', href: getUrl('/contact') },
  { name: 'FAQ', href: getUrl('/faq') },
  { name: 'Privacy Policy', href: getUrl('/privacy-policy') },
  { name: 'Terms of Service', href: getUrl('/terms') },
  { name: 'Search', href: getUrl('/search') }
];
---

<BaseLayout 
  title="HTML Sitemap | NI18 Mobile Apps Portfolio"
  description="Complete HTML sitemap of all mobile applications and technical blog posts published by NI18."
>
  <section class="section page-header">
    <div class="container">
      <Breadcrumb items={[{ name: 'Sitemap' }]} />
      <h1 class="display-large">HTML Sitemap</h1>
      <p class="body-large sub-desc">Index of all pages, mobile apps, and guides on www.ni18.in.</p>
    </div>
  </section>

  <section class="section">
    <div class="container sitemap-grid">
      <div class="sitemap-col">
        <h3 class="headline-medium col-title">Main Pages</h3>
        <ul class="sitemap-list">
          {staticPages.map((p) => (
            <li><a href={p.href} class="sitemap-link">{p.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="sitemap-col">
        <h3 class="headline-medium col-title">Android Applications</h3>
        <ul class="sitemap-list">
          {apps.map((a) => (
            <li><a href={getUrl(`/apps/${a.slug}`)} class="sitemap-link">{a.data.title}</a></li>
          ))}
        </ul>
      </div>

      <div class="sitemap-col">
        <h3 class="headline-medium col-title">Blog Articles &amp; Guides</h3>
        <ul class="sitemap-list">
          {blogPosts.map((b) => (
            <li><a href={getUrl(`/blog/${b.slug}`)} class="sitemap-link">{b.data.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { background-color: var(--md-sys-color-surface-container-low); }
  .sub-desc { margin-top: 0.75rem; }
  .sitemap-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .sitemap-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .col-title {
    color: var(--md-sys-color-primary);
    margin-bottom: 1rem;
  }
  .sitemap-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .sitemap-link {
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .sitemap-link:hover {
    color: var(--md-sys-color-primary);
    text-decoration: underline;
  }
</style>
