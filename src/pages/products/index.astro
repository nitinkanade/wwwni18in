---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import ProductsGrid from '../../components/sections/ProductsGrid.astro';
---

<BaseLayout 
  title="Products & Platforms | NI18"
  description="Discover NI18 flagship software platforms, including Digital Utility Suite and SFCC Quiz Master."
>
  <section class="section page-header">
    <div class="container">
      <Breadcrumb items={[{ name: 'Products' }]} />
      <h1 class="display-large">Products &amp; Platforms</h1>
      <p class="body-large sub-desc">Innovative developer tools, utilities, and training software built by NI18.</p>
    </div>
  </section>

  <ProductsGrid />
</BaseLayout>

<style>
  .page-header { background-color: var(--md-sys-color-surface-container-low); }
  .sub-desc { margin-top: 0.75rem; }
</style>
