---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import MdChip from '../../components/md3/MdChip.astro';
import Pagination from '../../components/common/Pagination.astro';
import { getUrl } from '../../utils/navigation';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const apps = await getCollection('apps');

const PAGE_SIZE = 6;
const paginatedPosts = posts.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
---

<BaseLayout 
  title="App Articles, Tutorials & Guides | NI18"
  description="Read technical guides, exam revision sheets, and learning tutorials for NI18 Android applications."
>
  <section class="section page-header">
    <div class="container">
      <Breadcrumb items={[{ name: 'Blog' }]} />
      <h1 class="display-large">Articles &amp; App Guides</h1>
      <p class="body-large sub-desc">Exam strategies, formula sheets, and grammar rules for NI18 mobile applications.</p>

      <div class="filter-bar">
        <span class="label-large">Filter by App:</span>
        <div class="chips-group">
          {apps.map((app) => (
            <MdChip href={getUrl(`/apps/${app.slug}/blog`)}>
              {app.data.title}
            </MdChip>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-3">
        {paginatedPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>

      <Pagination currentPage={1} totalPages={totalPages} baseUrl="/blog" />
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { background-color: var(--md-sys-color-surface-container-low); }
  .sub-desc { margin-top: 0.75rem; margin-bottom: 1.5rem; }
  .filter-bar {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }
  .chips-group { display: flex; flex-wrap: wrap; gap: 0.5rem; }
</style>
