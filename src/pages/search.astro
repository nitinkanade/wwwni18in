---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { getUrl } from '../utils/navigation';
---

<BaseLayout 
  title="Search NI18 Website | Static Fast Search"
  description="Search all pages, mobile apps, and blog articles across the NI18 website."
>
  <link rel="stylesheet" href={getUrl('/pagefind/pagefind-ui.css')} />

  <section class="section page-header">
    <div class="container">
      <Breadcrumb items={[{ name: 'Search' }]} />
      <h1 class="display-large">Search NI18</h1>
      <p class="body-large sub-desc">Instant client-side static search across all apps, articles, and documentation.</p>
    </div>
  </section>

  <section class="section">
    <div class="container search-container">
      <div id="search"></div>
    </div>
  </section>

  <script is:inline src={getUrl('/pagefind/pagefind-ui.js')}></script>
</BaseLayout>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    // Function to initialize Pagefind with base path awareness
    function initPagefind() {
      if (window.PagefindUI) {
        const path = window.location.pathname;
        const basePath = path.includes('/wwwni18in') ? '/wwwni18in/pagefind/' : '/pagefind/';
        
        new window.PagefindUI({
          element: "#search",
          bundlePath: basePath,
          showImages: false,
          showSubResults: true,
          highlightParam: "highlight"
        });
      }
    }

    if (window.PagefindUI) {
      initPagefind();
    } else {
      setTimeout(initPagefind, 500);
    }
  });
</script>

<style>
  .page-header { background-color: var(--md-sys-color-surface-container-low); }
  .sub-desc { margin-top: 0.75rem; }
  .search-container { max-width: 800px; min-height: 350px; }
</style>
