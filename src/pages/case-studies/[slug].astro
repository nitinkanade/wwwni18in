---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';

export async function getStaticPaths() {
  const caseStudies = await getCollection('case-studies');
  return caseStudies.map((cs) => ({
    params: { slug: cs.slug },
    props: { cs }
  }));
}

const { cs } = Astro.props;
const { Content } = await cs.render();
---

<BaseLayout 
  title={`${cs.data.title} | NI18 Case Study`}
  description={cs.data.description}
>
  <section class="section page-header">
    <div class="container">
      <Breadcrumb items={[
        { name: 'Case Studies', href: '/case-studies' },
        { name: cs.data.title }
      ]} />

      <h1 class="display-large">{cs.data.title}</h1>
      <p class="body-large sub-desc">{cs.data.description}</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose-container">
      <div class="prose-content">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { background-color: var(--md-sys-color-surface-container-low); }
  .sub-desc { margin-top: 0.75rem; }
  .prose-container { max-width: 820px; }
</style>
