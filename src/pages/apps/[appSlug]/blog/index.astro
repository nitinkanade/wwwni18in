---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/common/Breadcrumb.astro';
import BlogCard from '../../../../components/blog/BlogCard.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({
    params: { appSlug: app.slug },
    props: { app }
  }));
}

const { app } = Astro.props;

// Fetch blogs for this specific app
const appBlogs = await getCollection('blog', ({ data }) => !data.draft && data.appId === app.slug);
appBlogs.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout 
  title={`${app.data.title} - Articles & Guides | NI18`}
  description={`Read tutorials, revision guides, and articles for ${app.data.title} by NI18.`}
>
  <section class="section page-header">
    <div class="container">
      <Breadcrumb items={[
        { name: 'Apps', href: '/apps' },
        { name: app.data.title, href: `/apps/${app.slug}` },
        { name: 'Blog' }
      ]} />

      <h1 class="display-large">{app.data.title} - Articles &amp; Guides</h1>
      <p class="body-large sub-desc">Comprehensive revision sheets, tutorials, and exam guides related to {app.data.title}.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {appBlogs.length > 0 ? (
        <div class="grid-3">
          {appBlogs.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <div class="empty-box">
          <p class="body-large">No articles published for this app yet. Check back soon!</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { background-color: var(--md-sys-color-surface-container-low); }
  .sub-desc { margin-top: 0.75rem; }
  .empty-box {
    padding: 3rem;
    text-align: center;
    background-color: var(--md-sys-color-surface-container-low);
    border-radius: var(--md-sys-shape-corner-large);
  }
</style>
