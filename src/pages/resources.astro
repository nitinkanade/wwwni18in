---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';

const entry = await getEntry('pages', 'resources');
if (!entry) throw new Error('Resources content not found');
const { Content } = await entry.render();
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <section class="section page-header">
    <div class="container">
      <Breadcrumb items={[{ name: 'Resources' }]} />
      <h1 class="display-large">{entry.data.title}</h1>
      <p class="body-large sub-desc">{entry.data.description}</p>
    </div>
  </section>
  <section class="section">
    <div class="container prose-container">
      <div class="prose-content">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { background-color: var(--md-sys-color-surface-container-low); }
  .sub-desc { margin-top: 0.75rem; }
  .prose-container { max-width: 820px; }
</style>
