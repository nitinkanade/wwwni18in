---
import { getUrl } from '../../utils/navigation';

interface Props {
  type?: 'Organization' | 'WebSite' | 'Article' | 'FAQPage' | 'BreadcrumbList' | 'SoftwareApplication';
  data?: Record<string, any>;
}

const { type = 'Organization', data = {} } = Astro.props;

const siteUrl = Astro.site ? Astro.site.href : 'https://nitinkanade.github.io/wwwni18in/';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'NI18',
  'url': siteUrl,
  'logo': new URL(getUrl('/favicon.svg'), siteUrl).href,
  'sameAs': [
    'https://play.google.com/store/apps/dev?id=9029737187135646839',
    'https://github.com/nitinkanade/wwwni18in',
    'https://sites.google.com/view/ni18/home'
  ],
  'description': 'Independent Android software publisher engineering native mobile applications for competitive exam prep and language learning.'
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'NI18 Mobile Apps Portfolio',
  'url': siteUrl,
  'potentialAction': {
    '@type': 'SearchAction',
    'target': `${siteUrl}search?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

const finalSchema = type === 'Organization' 
  ? organizationSchema 
  : type === 'WebSite' 
  ? websiteSchema 
  : { '@context': 'https://schema.org', '@type': type, ...data };
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(finalSchema)} />
