---
import MdIcon from '../md3/MdIcon.astro';
import MdButton from '../md3/MdButton.astro';
import { getUrl } from '../../utils/navigation';

const pathname = new URL(Astro.request.url).pathname;

const navItems = [
  { name: 'Home', href: '/', icon: 'home' },
  { name: 'Apps Showcase', href: '/apps', icon: 'smartphone' },
  { name: 'Blog & Tutorials', href: '/blog', icon: 'article' },
  { name: 'About NI18', href: '/about', icon: 'info' },
  { name: 'FAQ', href: '/faq', icon: 'quiz' },
  { name: 'Contact Us', href: '/contact', icon: 'mail' },
  { name: 'Search', href: '/search', icon: 'search' }
];
---

<button 
  id="drawer-open-btn" 
  class="mobile-menu-btn" 
  aria-label="Open Mobile Navigation Menu"
  aria-expanded="false"
  aria-controls="mobile-drawer"
>
  <MdIcon name="menu" size="24px" />
</button>

<div id="drawer-overlay" class="drawer-overlay" aria-hidden="true"></div>

<div 
  id="mobile-drawer" 
  class="mobile-drawer" 
  role="dialog" 
  aria-modal="true" 
  aria-label="Mobile Navigation Drawer"
  inert
>
  <div class="drawer-header">
    <a href={getUrl('/')} class="drawer-logo" aria-label="NI18 Mobile Navigation Homepage Logo">
      <img src={getUrl('/images/logo.svg')} alt="NI18 Logo" width="120" height="30" />
    </a>
    <button id="drawer-close-btn" class="drawer-close-btn" aria-label="Close Mobile Menu">
      <MdIcon name="close" size="24px" />
    </button>
  </div>

  <nav class="drawer-nav" aria-label="Mobile Drawer Navigation Menu">
    <ul>
      {navItems.map((item) => {
        const fullHref = getUrl(item.href);
        const isActive = item.href === '/' ? pathname === getUrl('/') : pathname.startsWith(fullHref);
        return (
          <li>
            <a href={fullHref} class={`drawer-link ${isActive ? 'active' : ''}`}>
              <MdIcon name={item.icon} size="20px" />
              <span>{item.name}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="drawer-footer">
    <MdButton href="https://play.google.com/store/apps/dev?id=9029737187135646839" variant="filled" target="_blank" rel="noopener noreferrer" class="w-full">
      Google Play Console
    </MdButton>
  </div>
</div>

<style>
  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--md-sys-color-outline);
    color: var(--md-sys-color-on-surface);
    width: 40px;
    height: 40px;
    border-radius: var(--md-sys-shape-corner-medium);
    cursor: pointer;
  }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    visibility: hidden;
  }

  .drawer-overlay.open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 300px;
    max-width: 85vw;
    background-color: var(--md-sys-color-surface-container-lowest);
    z-index: 1000;
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.2, 0, 0, 1), visibility 0.3s linear;
    display: flex;
    flex-direction: column;
    box-shadow: var(--md-sys-elevation-4);
    visibility: hidden;
  }

  .mobile-drawer.open {
    transform: translateX(0);
    visibility: visible;
  }

  @media (min-width: 1024px) {
    .mobile-menu-btn { display: none !important; }
    .mobile-drawer { display: none !important; }
    .drawer-overlay { display: none !important; }
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }

  .drawer-close-btn {
    background: transparent;
    border: none;
    color: var(--md-sys-color-on-surface);
    cursor: pointer;
  }

  .drawer-nav {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0.75rem;
  }

  .drawer-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .drawer-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    border-radius: var(--md-sys-shape-corner-medium);
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .drawer-link:hover, .drawer-link.active {
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }

  .drawer-footer {
    padding: 1.25rem;
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }

  .w-full { width: 100%; }
</style>

<script is:inline>
  const openBtn = document.getElementById('drawer-open-btn');
  const closeBtn = document.getElementById('drawer-close-btn');
  const overlay = document.getElementById('drawer-overlay');
  const drawer = document.getElementById('mobile-drawer');

  function openDrawer() {
    drawer?.classList.add('open');
    overlay?.classList.add('open');
    drawer?.removeAttribute('inert');
    openBtn?.setAttribute('aria-expanded', 'true');
    overlay?.setAttribute('aria-hidden', 'false');
  }

  function closeDrawer() {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
    drawer?.setAttribute('inert', '');
    openBtn?.setAttribute('aria-expanded', 'false');
    overlay?.setAttribute('aria-hidden', 'true');
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);
</script>
