---
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  canonicalUrl?: string;
}

const {
  title,
  description,
  image = '/images/og-cover.png',
  article = false,
  pubDate,
  updatedDate,
  author = 'NI18 Technologies',
  canonicalUrl
} = Astro.props;

const siteTitle = title.includes('NI18') ? title : `${title} | NI18 Technologies`;
const currentCanonical = canonicalUrl || new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(image, Astro.site).href;
---

<!-- Primary Meta Tags -->
<title>{siteTitle}</title>
<meta name="title" content={siteTitle} />
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={currentCanonical} />

<!-- OpenGraph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={currentCanonical} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content="NI18 Technologies" />

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={currentCanonical} />
<meta property="twitter:title" content={siteTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<!-- Favicon & Web Manifest -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/manifest.webmanifest" />
<meta name="theme-color" content="#4f46e5" />

<!-- Verification Placeholders -->
<meta name="google-site-verification" content="GOOGLE_SEARCH_CONSOLE_VERIFICATION_TOKEN_PLACEHOLDER" />
<meta name="msvalidate.01" content="BING_WEBMASTER_VERIFICATION_TOKEN_PLACEHOLDER" />

{article && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{article && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{article && author && <meta property="article:author" content={author} />}
