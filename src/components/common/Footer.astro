---
import MdIcon from '../md3/MdIcon.astro';

const currentYear = new Date().getFullYear();

const navSections = [
  {
    title: 'Company',
    links: [
      { name: 'About NI18', href: '/about' },
      { name: 'Apps Portfolio', href: '/apps' },
      { name: 'Google Play Profile', href: 'https://play.google.com/store/apps/dev?id=9029737187135646839' },
      { name: 'FAQ', href: '/faq' },
      { name: 'Contact Us', href: '/contact' }
    ]
  },
  {
    title: 'Android Apps',
    links: [
      { name: 'JEE Maths Formulas', href: '/apps/jee-maths-formulas' },
      { name: 'MPSC Quiz Prep in Marathi', href: '/apps/mpsc-quiz-prep' },
      { name: 'English Grammar Book & Tests', href: '/apps/english-grammar-book-tests' },
      { name: 'English Grammar in Hindi', href: '/apps/english-grammar-in-hindi' },
      { name: 'English Grammar in Marathi', href: '/apps/english-grammar-in-marathi' }
    ]
  },
  {
    title: 'Technical Blog',
    links: [
      { name: 'All Articles', href: '/blog' },
      { name: 'JEE Maths Guides', href: '/apps/jee-maths-formulas/blog' },
      { name: 'MPSC Exam Tips', href: '/apps/mpsc-quiz-prep/blog' },
      { name: 'English Grammar Guides', href: '/apps/english-grammar-book-tests/blog' }
    ]
  },
  {
    title: 'Legal & Info',
    links: [
      { name: 'Privacy Policy', href: '/privacy-policy' },
      { name: 'Terms of Service', href: '/terms' },
      { name: 'Disclaimer', href: '/disclaimer' },
      { name: 'Cookie Policy', href: '/cookie-policy' },
      { name: 'HTML Sitemap', href: '/sitemap' }
    ]
  }
];
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <img src="/images/logo.svg" alt="NI18 Logo" width="140" height="35" loading="lazy" />
      </a>
      <p class="body-medium brand-desc">
        Engineering high-performance native Android applications for competitive exams, language learning, and education. Official Google Play Console Developer Profile ID 9029737187135646839.
      </p>
      <div class="contact-info">
        <a href="mailto:contact@ni18.in" class="contact-item">
          <MdIcon name="mail" size="18px" />
          <span>contact@ni18.in</span>
        </a>
        <a href="https://play.google.com/store/apps/dev?id=9029737187135646839" target="_blank" rel="noopener noreferrer" class="contact-item">
          <MdIcon name="shop" size="18px" />
          <span>Google Play Developer Profile</span>
        </a>
      </div>
    </div>

    <div class="footer-grid">
      {navSections.map((section) => (
        <div class="footer-col">
          <h2 class="title-small col-title">{section.title}</h2>
          <ul class="col-links">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="footer-link" target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.name}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container bottom-flex">
      <p class="body-small text-muted">
        © {currentYear} NI18 Technologies. Registered custom domain www.ni18.in.
      </p>
      <div class="bottom-links">
        <a href="/rss.xml" class="body-small footer-link">RSS Feed</a>
        <a href="/sitemap-index.xml" class="body-small footer-link">XML Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--md-sys-color-surface-container-lowest);
    border-top: 1px solid var(--md-sys-color-outline-variant);
    padding-top: 4rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  @media (min-width: 1024px) {
    .footer-content {
      grid-template-columns: 320px 1fr;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .brand-desc {
    color: var(--md-sys-color-on-surface-variant);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--md-sys-color-primary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .col-title {
    color: var(--md-sys-color-on-surface);
    margin-bottom: 1rem;
    font-size: 1rem;
    font-weight: 700;
  }

  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer-link {
    color: var(--md-sys-color-on-surface-variant);
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--md-sys-color-primary);
  }

  .footer-bottom {
    border-top: 1px solid var(--md-sys-color-outline-variant);
    padding: 1.5rem 0;
    background-color: var(--md-sys-color-surface-container-low);
  }

  .bottom-flex {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .bottom-flex {
      flex-direction: row;
    }
  }

  .text-muted {
    color: var(--md-sys-color-on-surface-variant);
  }

  .bottom-links {
    display: flex;
    gap: 1.5rem;
  }
</style>
