---
interface Props {
  name: string;
  size?: string;
  class?: string;
}

const { name, size = '24px', class: className = '' } = Astro.props;
---

<span 
  class={`material-symbols-outlined ${className}`} 
  style={`font-size: ${size}; display: inline-block; vertical-align: middle;`}
  aria-hidden="true"
>
  {name}
</span>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap');
</style>
