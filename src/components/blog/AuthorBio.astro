---
import MdIcon from '../md3/MdIcon.astro';

interface Props {
  author?: string;
}

const { author = 'Nikhil Sharma' } = Astro.props;
---

<div class="author-bio-card">
  <div class="author-avatar">
    <MdIcon name="account_circle" size="48px" />
  </div>
  <div class="author-details">
    <h4 class="title-medium author-name">Written by {author}</h4>
    <p class="body-small author-description">
      Founder &amp; Principal Software Engineer at NI18. Specializes in Kotlin Android architecture, Salesforce Commerce Cloud, and ultra-fast static web engineering.
    </p>
  </div>
</div>

<style>
  .author-bio-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    background-color: var(--md-sys-color-surface-container-low);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    margin-top: 3rem;
  }

  .author-avatar {
    color: var(--md-sys-color-primary);
    flex-shrink: 0;
  }

  .author-name {
    color: var(--md-sys-color-on-surface);
    margin-bottom: 0.25rem;
  }

  .author-description {
    color: var(--md-sys-color-on-surface-variant);
  }
</style>
