---
import MdCard from '../md3/MdCard.astro';
import MdIcon from '../md3/MdIcon.astro';

const techStack = [
  { name: 'Android & Kotlin', desc: 'Jetpack Compose, Room SQLite, Coroutines & Hilt', icon: 'smartphone' },
  { name: 'Astro & TypeScript', desc: 'Zero-JS static SSG, Content Layer & type safety', icon: 'bolt' },
  { name: 'Salesforce Commerce Cloud', desc: 'SFCC B2C cartridges, Page Designer & SCAPI', icon: 'shopping_cart' },
  { name: 'WebAssembly & Web Workers', desc: 'Fast client-side image compression & utilities', icon: 'memory' },
  { name: 'Material Design 3', desc: 'Google MD3 tokens, dynamic light/dark mode', icon: 'palette' },
  { name: 'Static Search & SEO', desc: 'Pagefind indexing, Schema.org JSON-LD & RSS', icon: 'search' }
];
---

<section class="section tech-section">
  <div class="container">
    <div class="section-header">
      <span class="label-large category-tag">TECHNOLOGY STACK</span>
      <h2 class="headline-large">Modern Tech Architecture</h2>
      <p class="body-large section-sub">
        We select maintainable, future-proof technologies built for maximum performance and security.
      </p>
    </div>

    <div class="grid-3">
      {techStack.map((tech) => (
        <MdCard variant="outlined" class="tech-card">
          <div class="tech-icon">
            <MdIcon name={tech.icon} size="28px" />
          </div>
          <h3 class="title-medium">{tech.name}</h3>
          <p class="body-small">{tech.desc}</p>
        </MdCard>
      ))}
    </div>
  </div>
</section>

<style>
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
  }

  .category-tag {
    color: var(--md-sys-color-primary);
    font-weight: 700;
  }

  .tech-card {
    text-align: center;
    align-items: center;
  }

  .tech-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--md-sys-shape-corner-full);
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }
</style>
