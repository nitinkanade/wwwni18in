---
import { getCollection } from 'astro:content';
import MdCard from '../md3/MdCard.astro';
import MdIcon from '../md3/MdIcon.astro';

const services = await getCollection('services');
services.sort((a, b) => a.data.order - b.data.order);
---

<section class="section services-section">
  <div class="container">
    <div class="section-header">
      <span class="label-large category-tag">OUR EXPERTISE</span>
      <h2 class="headline-large">Engineering &amp; Consulting Services</h2>
      <p class="body-large section-sub">
        End-to-end software solutions designed for speed, security, and exceptional user experience.
      </p>
    </div>

    <div class="grid-3">
      {services.map((service) => (
        <MdCard href={`/services/${service.slug}`} variant="interactive" class="service-card">
          <div class="service-icon-box">
            <MdIcon name={service.data.icon} size="28px" />
          </div>
          <h3 class="title-large service-title">{service.data.title}</h3>
          <p class="body-medium service-desc">{service.data.summary}</p>
          
          <ul class="feature-list">
            {service.data.features.slice(0, 3).map((feat) => (
              <li>
                <MdIcon name="check_circle" size="16px" class="check-icon" />
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <div class="card-arrow">
            <span>Learn More</span>
            <MdIcon name="chevron_right" size="18px" />
          </div>
        </MdCard>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: var(--md-sys-color-surface-container-low);
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
  }

  .category-tag {
    color: var(--md-sys-color-primary);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .section-sub {
    margin-top: 0.75rem;
  }

  .service-icon-box {
    width: 52px;
    height: 52px;
    border-radius: var(--md-sys-shape-corner-medium);
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .service-title {
    margin-bottom: 0.75rem;
    color: var(--md-sys-color-on-surface);
  }

  .service-desc {
    margin-bottom: 1.25rem;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .feature-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--md-sys-color-on-surface-variant);
  }

  .check-icon {
    color: var(--md-sys-color-secondary);
  }

  .card-arrow {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--md-sys-color-primary);
    font-weight: 700;
    font-size: 0.9rem;
  }
</style>
