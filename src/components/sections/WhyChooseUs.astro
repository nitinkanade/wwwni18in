---
import MdIcon from '../md3/MdIcon.astro';

const benefits = [
  { title: '100/100 Core Web Vitals', desc: 'Zero client-side JavaScript bloat guarantees instant page loads and top SEO rankings.', icon: 'speed' },
  { title: 'Offline-First Mobile Architecture', desc: 'Native Android apps engineered for uninterrupted reliability even in weak connectivity.', icon: 'wifi_off' },
  { title: 'Pure Static & Zero Maintenance', desc: 'No backend servers, no database vulnerabilities, no ongoing cloud infrastructure costs.', icon: 'verified_user' },
  { title: 'Google Material Design 3', desc: 'Sleek, modern UI system with fluid dark and light modes built with native CSS custom tokens.', icon: 'auto_awesome' }
];
---

<section class="section why-section">
  <div class="container">
    <div class="section-header">
      <span class="label-large category-tag">WHY NI18</span>
      <h2 class="headline-large">Engineering Excellence &amp; Speed</h2>
    </div>

    <div class="grid-2">
      {benefits.map((item) => (
        <div class="benefit-item">
          <div class="benefit-icon">
            <MdIcon name={item.icon} size="28px" />
          </div>
          <div>
            <h3 class="title-medium mb-1">{item.title}</h3>
            <p class="body-medium">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-section {
    background-color: var(--md-sys-color-surface-container-low);
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
  }

  .category-tag {
    color: var(--md-sys-color-primary);
    font-weight: 700;
  }

  .benefit-item {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    background-color: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
  }

  .benefit-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--md-sys-shape-corner-medium);
    background-color: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .mb-1 { margin-bottom: 0.35rem; }
</style>
