---
import { getCollection } from 'astro:content';
import BlogCard from '../blog/BlogCard.astro';

const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = posts.slice(0, 3);
---

<section class="section recent-blogs-section">
  <div class="container">
    <div class="section-header">
      <span class="label-large category-tag">INSIGHTS &amp; TUTORIALS</span>
      <h2 class="headline-large">Latest Technical Articles</h2>
      <p class="body-large section-sub">
        Explore programming tutorials, Android Compose guides, SFCC insights, and web speed optimizations.
      </p>
    </div>

    <div class="grid-3">
      {recentPosts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </div>
</section>

<style>
  .recent-blogs-section {
    background-color: var(--md-sys-color-surface-container-low);
  }

  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
  }

  .category-tag {
    color: var(--md-sys-color-primary);
    font-weight: 700;
  }
</style>
