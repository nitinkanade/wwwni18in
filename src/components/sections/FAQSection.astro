---
import MdIcon from '../md3/MdIcon.astro';

const faqs = [
  { q: 'What Android applications does NI18 publish?', a: 'NI18 publishes native Android software including JEE Maths Formulas, MPSC Quiz Prep in Marathi, English Grammar Book & Tests, and localized English grammar learning apps in Hindi and Marathi on Google Play.' },
  { q: 'Are NI18 Android apps free and offline-accessible?', a: 'Yes. All NI18 applications are designed offline-first, allowing students and exam aspirants to review formulas, grammar rules, and practice quizzes anywhere with zero data consumption.' },
  { q: 'Where can I download the official NI18 mobile apps?', a: 'You can download all official NI18 Android applications directly from the Google Play Store under Developer Account ID 9029737187135646839.' },
  { q: 'Are legacy website links preserved during the redesign?', a: 'Yes. All legacy URLs indexed by search engines are preserved and configured with 404 client-side fallbacks and HTML redirects to safeguard SEO rankings.' }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((f) => ({
    '@type': 'Question',
    'name': f.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.a
    }
  }))
};
---

<section class="section faq-section">
  <div class="container">
    <div class="section-header">
      <span class="label-large category-tag">FAQ</span>
      <h2 class="headline-large">Frequently Asked Questions</h2>
    </div>

    <div class="faq-list">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary class="faq-summary">
            <span class="title-medium">{faq.q}</span>
            <MdIcon name="expand_more" size="24px" class="faq-icon" />
          </summary>
          <div class="faq-answer">
            <p class="body-medium">{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

<style>
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
  }

  .category-tag {
    color: var(--md-sys-color-primary);
    font-weight: 700;
  }

  .faq-list {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background-color: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    padding: 1.25rem 1.5rem;
    transition: border-color 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--md-sys-color-primary);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    transition: transform 0.2s ease;
    color: var(--md-sys-color-primary);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--md-sys-color-outline-variant);
  }
</style>
