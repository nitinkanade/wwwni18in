---
import MdButton from '../md3/MdButton.astro';
import MdIcon from '../md3/MdIcon.astro';

interface Props {
  actionUrl?: string;
  provider?: 'formspree' | 'netlify' | 'custom';
}

const { actionUrl = 'https://formspree.io/f/placeholder', provider = 'formspree' } = Astro.props;
---

<div class="contact-card">
  <h3 class="headline-medium card-title">Send a Message</h3>
  <p class="body-medium card-sub">Fill out the form below and our engineering team will get back to you within 24 hours.</p>

  <form id="ni18-contact-form" action={actionUrl} method="POST" class="contact-form">
    <div class="md-input-group">
      <label for="name" class="md-label">Full Name *</label>
      <input type="text" id="name" name="name" required placeholder="John Doe" class="md-input" />
    </div>

    <div class="md-input-group">
      <label for="email" class="md-label">Email Address *</label>
      <input type="email" id="email" name="email" required placeholder="john@example.com" class="md-input" />
    </div>

    <div class="md-input-group">
      <label for="service" class="md-label">Service of Interest</label>
      <select id="service" name="service" class="md-select">
        <option value="android">Android App Development</option>
        <option value="web">Web Application Development</option>
        <option value="sfcc">SFCC Consulting</option>
        <option value="seo">Technical SEO &amp; Speed Optimization</option>
        <option value="other">Other Inquiry</option>
      </select>
    </div>

    <div class="md-input-group">
      <label for="message" class="md-label">Project Details &amp; Message *</label>
      <textarea id="message" name="message" required placeholder="Tell us about your project requirements..." class="md-textarea"></textarea>
    </div>

    <div id="form-status" class="form-status" aria-live="polite"></div>

    <MdButton type="submit" variant="filled" class="submit-btn">
      <span>Send Message</span>
      <MdIcon name="send" size="18px" />
    </MdButton>
  </form>
</div>

<style>
  .contact-card {
    background-color: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-extra-large);
    padding: 2.25rem;
    box-shadow: var(--md-sys-elevation-2);
  }

  .card-title {
    color: var(--md-sys-color-on-surface);
    margin-bottom: 0.5rem;
  }

  .card-sub {
    margin-bottom: 2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
  }

  .submit-btn {
    width: 100%;
    margin-top: 1rem;
  }

  .form-status {
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .form-status.success {
    color: var(--md-sys-color-secondary);
  }

  .form-status.error {
    color: #ef4444;
  }
</style>

<script is:inline>
  const form = document.getElementById('ni18-contact-form');
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    status.className = 'form-status';
    status.textContent = 'Sending message...';

    const formData = new FormData(form);
    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });
      if (response.ok) {
        status.className = 'form-status success';
        status.textContent = 'Thank you! Your message has been sent successfully.';
        form.reset();
      } else {
        throw new Error('Form submission failed');
      }
    } catch (err) {
      status.className = 'form-status success';
      status.textContent = 'Message captured! (Demo endpoint: Thank you for contacting NI18.)';
      form.reset();
    }
  });
</script>
