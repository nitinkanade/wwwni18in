---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import ShareButtons from '../components/blog/ShareButtons.astro';
import AuthorBio from '../components/blog/AuthorBio.astro';
import SchemaOrg from '../components/common/SchemaOrg.astro';
import MdBadge from '../components/md3/MdBadge.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const { title, description, pubDate, updatedDate, author, category } = post.data;

const formattedPubDate = pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const formattedUpdatedDate = updatedDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Estimate reading time based on word count
const wordCount = post.body ? post.body.split(/\s+/).length : 500;
const readingTime = Math.ceil(wordCount / 200);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'description': description,
  'author': {
    '@type': 'Person',
    'name': author
  },
  'datePublished': pubDate.toISOString(),
  'dateModified': (updatedDate || pubDate).toISOString(),
  'publisher': {
    '@type': 'Organization',
    'name': 'NI18',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://www.ni18.in/favicon.svg'
    }
  }
};
---

<BaseLayout 
  title={title} 
  description={description} 
  article={true} 
  pubDate={pubDate} 
  updatedDate={updatedDate} 
  author={author}
>
  <SchemaOrg type="Article" data={articleSchema} />

  <article class="blog-post-article">
    <header class="post-header section">
      <div class="container">
        <Breadcrumb items={[
          { name: 'Blog', href: '/blog' },
          { name: category, href: `/blog/category/${category.toLowerCase()}` },
          { name: title }
        ]} />

        <div class="post-header-content">
          <div class="post-meta-badges">
            <MdBadge>{category}</MdBadge>
            <span class="reading-time">{readingTime} min read</span>
          </div>

          <h1 class="display-large post-title">{title}</h1>
          <p class="body-large post-desc">{description}</p>

          <div class="post-author-meta">
            <span class="author-name">By {author}</span>
            <span class="meta-dot">•</span>
            <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
            {updatedDate && (
              <>
                <span class="meta-dot">•</span>
                <span class="updated-date">Updated {formattedUpdatedDate}</span>
              </>
            )}
          </div>
        </div>
      </div>
    </header>

    <div class="container post-body-grid">
      <main class="post-main-content">
        <TableOfContents headings={headings} />
        
        <div class="prose-content">
          <slot />
        </div>

        <ShareButtons title={title} />
        <AuthorBio author={author} />
      </main>
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    background-color: var(--md-sys-color-surface-container-low);
    padding-bottom: 3rem;
  }

  .post-header-content {
    max-width: 820px;
    margin-top: 1.5rem;
  }

  .post-meta-badges {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .reading-time {
    font-size: 0.85rem;
    color: var(--md-sys-color-on-surface-variant);
    font-weight: 600;
  }

  .post-title {
    margin-bottom: 1rem;
    color: var(--md-sys-color-on-surface);
  }

  .post-desc {
    margin-bottom: 1.5rem;
    color: var(--md-sys-color-on-surface-variant);
  }

  .post-author-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--md-sys-color-on-surface-variant);
    font-weight: 500;
  }

  .meta-dot {
    color: var(--md-sys-color-outline);
  }

  .post-body-grid {
    padding-top: 3rem;
    padding-bottom: 5rem;
    max-width: 860px;
  }

  .prose-content {
    line-height: 1.8;
    font-size: 1.05rem;
    color: var(--md-sys-color-on-surface);
  }

  .prose-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 90px;
  }

  .prose-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 90px;
  }

  .prose-content :global(p) {
    margin-bottom: 1.5rem;
    color: var(--md-sys-color-on-surface-variant);
  }

  .prose-content :global(ul), .prose-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: var(--md-sys-color-on-surface-variant);
  }

  .prose-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose-content :global(pre) {
    border-radius: var(--md-sys-shape-corner-medium);
    padding: 1.25rem;
    margin: 1.75rem 0;
    overflow-x: auto;
    border: 1px solid var(--md-sys-color-outline);
  }

  .prose-content :global(blockquote) {
    border-left: 4px solid var(--md-sys-color-primary);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--md-sys-color-on-surface);
  }
</style>
